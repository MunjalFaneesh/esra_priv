---
/**
 * Field guides index.
 */
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import MonoLabel from '../../components/ui/MonoLabel.astro';

const docs = (await getCollection('docs'))
  .filter((d) => import.meta.env.DEV || !d.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Guides"
  description="Field guides for building, flashing, and calibrating ESRA hardware."
  sourcePath="site/docs/index.astro"
>
  <Section pad="hero">
    <MonoLabel as="div" size="sm" track="label">Field guides</MonoLabel>
    <h1>Guides</h1>
    <p class="lede">
      Build notes and procedures, written so someone outside the group can follow them.
    </p>
  </Section>

  <Section pad="normal" last>
    {
      docs.length === 0 ? (
        <p class="empty">No guides published yet.</p>
      ) : (
        <div class="list">
          {docs.map((doc, i) => (
            <a class="row" href={`/docs/${doc.id}`}>
              <MonoLabel size="micro" track="wide">
                G-{String(i + 1).padStart(2, '0')}
              </MonoLabel>
              <span class="text">
                <strong>{doc.data.title}</strong>
                {doc.data.description && <span class="desc">{doc.data.description}</span>}
              </span>
              <MonoLabel size="micro" track="wide" class="dur">
                {doc.data.duration ?? ''} &#8594;
              </MonoLabel>
            </a>
          ))}
        </div>
      )
    }
  </Section>
</BaseLayout>

<style>
  h1 {
    margin: var(--u) 0 0;
    font-family: var(--font-display);
    font-size: var(--t-display);
    font-weight: var(--w-bold);
    line-height: 1.05;
    letter-spacing: var(--track-snug);
    text-transform: uppercase;
  }

  .lede {
    margin: var(--u) 0 0;
    max-width: 456px;
    font-size: var(--t-md);
    line-height: var(--lh-grid);
    color: var(--ink-body);
  }

  .list {
    border-top: var(--rule-width) solid var(--rule);
  }

  .row {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    align-items: center;
    gap: 20px;
    padding: var(--u-half) 4px;
    border-bottom: var(--rule-width) solid var(--rule);
    text-decoration: none;
    color: var(--ink-strong);
    transition: background var(--dur-fast) var(--ease);
  }

  .row:hover {
    background: rgba(36, 36, 36, 0.04);
    color: var(--ink-strong);
  }

  .text strong {
    display: block;
    font-size: var(--t-lg);
    font-weight: var(--w-semibold);
    line-height: var(--lh-grid);
  }

  .desc {
    display: block;
    font-size: var(--t-sm);
    line-height: var(--lh-grid);
    color: var(--ink-muted);
  }

  .empty {
    font-size: var(--t-base);
    color: var(--ink-muted);
  }

  @media (max-width: 560px) {
    .row {
      grid-template-columns: 48px 1fr;
    }
    .row :global(.dur) {
      display: none;
    }
  }
</style>
