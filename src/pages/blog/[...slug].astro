---
/**
 * A blog post.
 *
 * The body renders inside a wide container with a reserved margin column,
 * so <MarginNote> and <Fig margin> float into it exactly as the design
 * intends, and fold inline below 1000px.
 *
 * MDX components are injected here, which is what lets an author write
 * <Fig …/> in a post with no import line.
 */
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';

import BaseLayout from '../../layouts/BaseLayout.astro';
import Prose from '../../components/ui/Prose.astro';
import MonoLabel from '../../components/ui/MonoLabel.astro';
import LinkChip from '../../components/ui/LinkChip.astro';
import Comments from '../../components/blog/Comments.astro';
import { mdxComponents } from '../../components/blog';
import { readingTime } from '../../lib/reading-time';
import { memberPath } from '../../lib/routes';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => import.meta.env.DEV || !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);

// Resolve author references to full member records for the byline.
const authors = await Promise.all(post.data.authors.map((ref) => getEntry(ref)));

const minutes = readingTime(remarkPluginFrontmatter?.wordCount);
const dateStr = post.data.date.toISOString().slice(0, 10);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description ?? post.data.title}
  sourcePath={`content/blog/${post.id}.md`}
  type="article"
  publishedAt={post.data.date}
>
  <article class="post">
    <header class="title-block">
      <MonoLabel as="div" size="sm" track="label">
        Build log{post.data.category ? ` · ${post.data.category}` : ''}
      </MonoLabel>

      <h1>{post.data.title}</h1>

      <MonoLabel as="div" size="sm" track="widest" class="byline">
        {
          authors.map((a, i) => (
            <>
              {i > 0 && ' · '}
              <a href={memberPath(a!)}>{a!.data.name}</a>
              {a!.data.affiliation && <span class="affil"> — {a!.data.affiliation}</span>}
            </>
          ))
        }
      </MonoLabel>

      <MonoLabel as="div" size="sm" track="wide" upper={false} class="dateline">
        <time datetime={post.data.date.toISOString()}>{dateStr}</time>
        {minutes && <> · {minutes}</>}
        {post.data.tags.length > 0 && <> · {post.data.tags.map((t) => `#${t}`).join(' ')}</>}
      </MonoLabel>
    </header>

    {
      post.data.description && (
        <div class="abstract">
          <MonoLabel as="div" size="micro" track="label">
            Abstract
          </MonoLabel>
          <p>{post.data.description}</p>
        </div>
      )
    }

    {
      post.data.cover && (
        <div class="cover">
          <Image
            src={post.data.cover}
            alt={post.data.coverAlt ?? ''}
            width={1600}
            loading="eager"
          />
        </div>
      )
    }

    <div class="body">
      <Prose width="full">
        <Content components={mdxComponents} />
      </Prose>
    </div>

    <Comments slug={post.id} title={post.data.title} />
  </article>
</BaseLayout>

<style>
  .post {
    padding: var(--u-3) var(--u-2) var(--u-2);
    max-width: var(--measure-wide);
    margin: 0 auto;
  }

  .title-block {
    text-align: center;
    padding-bottom: var(--u-2);
    border-bottom: var(--rule-width) solid var(--rule);
  }

  h1 {
    margin: var(--u) 0 0;
    font-size: var(--t-h1);
    font-weight: var(--w-semibold);
    line-height: var(--lh-h1);
    letter-spacing: var(--track-tight);
  }

  .post :global(.byline) {
    display: block;
    margin-top: var(--u);
  }

  .affil {
    color: var(--ink-muted);
  }

  .post :global(.dateline) {
    display: block;
    margin-top: var(--u-quarter);
  }

  .abstract {
    max-width: var(--measure);
    margin: var(--u-2) auto 0;
    padding-left: 20px;
    border-left: var(--rule-width) solid var(--rule-strong);
  }

  .abstract p {
    margin: var(--u-quarter) 0 0;
    font-size: var(--t-md);
    line-height: var(--lh-grid);
    font-style: italic;
    color: var(--ink-body);
  }

  .cover {
    margin: var(--u-2) 0 0;
    border: var(--rule-width) solid var(--rule-strong);
  }

  .cover :global(img) {
    width: 100%;
    height: auto;
    filter: grayscale(1) contrast(1.08);
  }

  /* Reserve the margin-note column. Components float into the negative
     gutter; below this width they fold inline (see MarginNote). */
  .body {
    position: relative;
    padding-right: var(--margin-gutter);
    margin-top: var(--u-2);
  }

  @media (max-width: 1000px) {
    .body {
      padding-right: 0;
    }
  }

  @media (max-width: 860px) {
    .post {
      padding: var(--u-2) var(--u) var(--u);
    }
  }

  @media (max-width: 480px) {
    .post {
      padding: var(--u-2) var(--u-half) var(--u);
    }
  }
</style>
