---
/**
 * Home.
 *
 * Every figure on this page is real: repo stats come from the GitHub API
 * at build time, videos from the orgs' channel feeds. Where data isn't
 * available the section renders without it rather than with a placeholder.
 */
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';

import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import MonoLabel from '../components/ui/MonoLabel.astro';
import DataGrid from '../components/ui/DataGrid.astro';
import LinkChip from '../components/ui/LinkChip.astro';
import Figure from '../components/ui/Figure.astro';
import LinkedInPost from '../components/blog/LinkedInPost.astro';
import { SITE } from '../data/site';
import { getPublicRepos, relativeTime } from '../lib/github';
import { getLatestPerOrg } from '../lib/youtube';
import { resolveAsset } from '../lib/assets';

const [repos, videos, partners, allPosts, allFeatured] = await Promise.all([
  getPublicRepos(),
  getLatestPerOrg(),
  getCollection('partners'),
  getCollection('blog'),
  getCollection('featured'),
]);

// Hand-curated showcase items lead the Featured strip; generated repo and
// video tiles fill the rest of the row.
const featured = allFeatured
  .filter((f) => !f.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const posts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);

const postsWithAuthors = await Promise.all(
  posts.map(async (post) => ({
    post,
    authors: await Promise.all(post.data.authors.map((ref) => getEntry(ref))),
  }))
);

const topRepos = repos.slice(0, 3);
const heroImage = resolveAsset('gallery/leg-test-stand.jpg');

// Counts are derived, not asserted: the schools figure is the number of
// distinct institutions actually represented in the partners list.
const schoolCount = new Set(partners.map((p) => p.data.school)).size;
---

<BaseLayout sourcePath="site/index.astro">
  <!-- Hero -->
  <Section pad="hero">
    <div class="hero">
      <div>
        <MonoLabel as="div" size="sm" track="label" class="on-grid"
          >Robotics, built in the open</MonoLabel
        >

        <h1 class="on-grid">We ship<br />robots in<br />the open.</h1>

        <p class="lede on-grid">
          A student-run consortium building fully open-source legged robots — actuators, firmware,
          and field guides. Read the source. Fork the boards.
        </p>

        <div class="actions">
          <LinkChip href={SITE.orgUrl} platform="github" label="github.com/esrabot" solid />
          <a href="/docs">Read the guides</a>
        </div>

        <MonoLabel as="div" size="sm" track="wide" class="stats on-grid">
          <span><strong>Est.</strong> {SITE.established}</span>
          <span
            ><strong>{schoolCount}</strong> schools · <strong>{partners.length}</strong> clubs</span
          >
          <span><strong>MIT</strong> + CERN-OHL-S</span>
        </MonoLabel>
      </div>

      <Figure
        src={heroImage}
        alt="The leg test stand, assembled on a linear slide."
        plate="FIG.1 — LEG TEST STAND"
        ratio="4/5"
        width={900}
        loading="eager"
      >
        <Fragment slot="caption">
          <strong>Figure 1.</strong> Leg test stand. Designed by Luis Serrano Laguna. Photo by Ryan Rudes.
        </Fragment>
      </Figure>
    </div>
  </Section>

  <!-- Featured: curated items first, then whatever the feeds return -->
  {
    (featured.length > 0 || videos.length > 0 || topRepos.length > 0) && (
      <Section id="featured" pad="normal">
        <SectionHead title="Featured — posts, video, repos" aside="curated · latest" />
        <DataGrid min="280px">
          {featured.map((item) =>
            item.data.type === 'linkedin' && item.data.activityId ? (
              <LinkedInPost
                activityId={item.data.activityId}
                title={item.data.title}
                summary={item.data.summary}
                source={item.data.org === 'rutgers-dynamics' ? 'Rutgers Dynamics' : 'ESRA'}
                url={item.data.url}
                date={item.data.date}
              />
            ) : (
              <a class="card" href={item.data.url} rel="noopener" target="_blank">
                <div class="card-body">
                  <MonoLabel as="div" size="micro" track="wider">
                    {item.data.org === 'rutgers-dynamics' ? 'Rutgers Dynamics' : 'ESRA'}
                  </MonoLabel>
                  <strong>{item.data.title}</strong>
                  {item.data.summary && <p class="card-summary">{item.data.summary}</p>}
                  <MonoLabel as="div" size="sm" track="wide" upper={false} class="go">
                    Open &#8599;
                  </MonoLabel>
                </div>
              </a>
            )
          )}

          {videos.map((video) => (
            <a class="card" href={video.url} rel="noopener" target="_blank">
              <div class="card-media">
                <img src={video.thumbnail} alt="" loading="lazy" decoding="async" />
                <span class="tag">Video</span>
              </div>
              <div class="card-body">
                <MonoLabel as="div" size="micro" track="wider">
                  YouTube · {video.orgName}
                </MonoLabel>
                <strong>{video.title}</strong>
                <MonoLabel as="div" size="sm" track="wide" upper={false} class="go">
                  Watch &#8599;
                </MonoLabel>
              </div>
            </a>
          ))}

          {topRepos.slice(0, Math.max(1, 3 - featured.length - videos.length)).map((repo) => (
            <a class="card" href={repo.url} rel="noopener" target="_blank">
              <div class="card-media terminal">
                <span class="tag">Repo</span>
                {/* set:html so the formatter cannot reflow whitespace that
                    <pre> would then render as leading indentation. */}
                <pre
                  set:html={[
                    `$ gh repo view ${repo.name}`,
                    `${repo.language ?? 'n/a'} · ${repo.stars} stars`,
                    `updated ${relativeTime(repo.pushedAt)}`,
                  ].join('\n')}
                />
              </div>
              <div class="card-body">
                <MonoLabel as="div" size="micro" track="wider">
                  GitHub · esrabot
                </MonoLabel>
                <strong>{repo.name}</strong>
                <MonoLabel as="div" size="sm" track="wide" upper={false} class="go">
                  View repo &#8599;
                </MonoLabel>
              </div>
            </a>
          ))}
        </DataGrid>
      </Section>
    )
  }

  <!-- Projects, straight from the org -->
  {
    repos.length > 0 && (
      <Section id="projects" pad="normal">
        <SectionHead title="Latest open source">
          <a slot="aside" href="/projects">
            all projects &#8594;
          </a>
        </SectionHead>
        <DataGrid min="260px">
          {topRepos.map((repo) => (
            <article class="repo-cell">
              <div class="repo-top">
                <span class="dot" aria-hidden="true" />
                <span class="repo-name">{repo.name}</span>
              </div>
              <p class="repo-desc">{repo.description ?? 'No description yet.'}</p>
              <MonoLabel as="div" size="micro" track="wide" class="repo-meta">
                <span>
                  {repo.language ?? 'n/a'} · &#9733; {repo.stars}
                </span>
                <span>{relativeTime(repo.pushedAt)}</span>
              </MonoLabel>
            </article>
          ))}
        </DataGrid>
      </Section>
    )
  }

  <!-- From the log -->
  {
    postsWithAuthors.length > 0 && (
      <Section id="blog" pad="normal">
        <SectionHead title="From the log">
          <a slot="aside" href="/blog">
            all posts &#8594;
          </a>
        </SectionHead>
        <DataGrid cols={2} min="300px">
          {postsWithAuthors.map(({ post, authors }) => (
            <article class="post-cell">
              <MonoLabel as="div" size="micro" track="widest">
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toISOString().slice(0, 10)}
                </time>
                {post.data.category && <> · {post.data.category}</>}
              </MonoLabel>
              <h3>
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
              </h3>
              {post.data.description && <p>{post.data.description}</p>}
              <MonoLabel as="div" size="micro" track="wide" upper={false} class="post-by">
                {authors.map((a) => a!.data.name).join(' · ')}
              </MonoLabel>
            </article>
          ))}
        </DataGrid>
      </Section>
    )
  }

  <!-- Member organisations -->
  <Section id="clubs" pad="normal" last>
    <SectionHead
      title="Member organisations"
      aside={`N=${partners.length} · consortium registry`}
    />
    <DataGrid min="230px">
      {
        partners.map((p, i) => (
          <a class="club" href={p.data.url} rel="noopener" target="_blank">
            <MonoLabel as="div" size="micro" track="wide" class="club-idx">
              <span>{String(i + 1).padStart(3, '0')}</span>
              <span>{p.data.abbr ?? ''}</span>
            </MonoLabel>
            <div class="club-name">{p.data.name}</div>
            <MonoLabel as="div" size="micro" track="wide" upper={false}>
              {[p.data.location, p.data.abbr].filter(Boolean).join(' · ')}
            </MonoLabel>
          </a>
        ))
      }
      <a class="club add" href={`mailto:${'ccbrrobotics@gmail.com'}`}>
        <MonoLabel as="div" size="micro" track="wide" class="club-idx">
          <span>{String(partners.length + 1).padStart(3, '0')}</span><span>+</span>
        </MonoLabel>
        <div class="club-name muted">Add your club &#8594;</div>
      </a>
    </DataGrid>
  </Section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.12fr 0.88fr;
    gap: var(--u-2);
    align-items: start;
  }

  h1 {
    margin: var(--u) 0 0;
    font-family: var(--font-display);
    font-size: var(--t-hero);
    font-weight: var(--w-bold);
    --lh: var(--lh-hero);
    line-height: var(--lh);
    letter-spacing: var(--track-snug);
    text-transform: uppercase;
  }

  .lede {
    margin: var(--u) 0 0;
    max-width: 432px;
    font-size: var(--t-md);
    line-height: var(--lh-grid);
    color: var(--ink-body);
  }

  .actions {
    display: flex;
    gap: var(--u);
    align-items: center;
    margin-top: var(--u-2);
    font-size: var(--t-base);
    flex-wrap: wrap;
  }

  .hero :global(.stats) {
    display: flex;
    gap: var(--u-2);
    margin-top: var(--u-2);
    flex-wrap: wrap;
  }

  .hero :global(.stats) strong {
    color: var(--ink-strong);
    font-weight: var(--w-semibold);
  }

  /* --- cards --- */
  .card {
    display: block;
    text-decoration: none;
    color: var(--ink-strong);
  }

  .card:hover {
    color: var(--ink-strong);
  }

  .card-media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--sheet-sunk);
    border-bottom: var(--rule-width) solid var(--rule);
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.1);
  }

  .card-media.terminal {
    background: var(--sheet);
    padding: var(--u-2) var(--u-half) var(--u-half);
  }

  .card-media.terminal pre {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    line-height: 18px; /* sub-grid: terminal card sets its own rhythm */
    color: var(--ink-muted);
    white-space: pre-wrap;
  }

  .tag {
    position: absolute;
    top: 8px;
    left: 8px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: var(--track-widest);
    text-transform: uppercase;
    background: var(--ink);
    color: var(--ink-inverse);
    padding: 3px 6px;
  }

  .card-body {
    padding: 20px;
  }

  .card-body strong {
    display: block;
    margin-top: var(--u-quarter);
    font-size: var(--t-lg);
    font-weight: var(--w-semibold);
    line-height: var(--lh-grid);
    letter-spacing: var(--track-snug);
  }

  .card-summary {
    margin: var(--u-quarter) 0 0;
    font-size: var(--t-base);
    line-height: var(--lh-grid);
    color: var(--ink-body);
  }

  .card-body :global(.go) {
    display: block;
    margin-top: var(--u-half);
    color: var(--accent-ink);
  }

  /* --- repo cells --- */
  .repo-cell {
    padding: var(--u);
  }

  .repo-top {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--ink-strong);
    opacity: 0.7;
  }

  .repo-name {
    font-family: var(--font-mono);
    font-size: var(--t-base);
    font-weight: var(--w-semibold);
    overflow-wrap: anywhere;
  }

  .repo-desc {
    margin: var(--u-half) 0 var(--u);
    font-size: var(--t-base);
    line-height: var(--lh-grid);
    color: var(--ink-body);
    min-height: 3em;
  }

  .repo-cell :global(.repo-meta) {
    display: flex;
    justify-content: space-between;
    border-top: var(--rule-width) solid var(--rule-soft);
    padding-top: var(--u-half);
  }

  /* --- post cells --- */
  .post-cell {
    padding: var(--u);
  }

  .post-cell h3 {
    margin: var(--u-half) 0;
    font-size: var(--t-h3);
    font-weight: var(--w-semibold);
    letter-spacing: var(--track-snug);
    line-height: var(--lh-grid);
  }

  .post-cell h3 a {
    text-decoration: none;
  }

  .post-cell p {
    margin: 0;
    font-size: var(--t-base);
    line-height: var(--lh-grid);
    color: var(--ink-body);
  }

  .post-cell :global(.post-by) {
    display: block;
    margin-top: var(--u);
    padding-top: var(--u-half);
    border-top: var(--rule-width) solid var(--rule-soft);
  }

  /* --- clubs --- */
  .club {
    display: block;
    padding: var(--u);
    text-decoration: none;
    color: var(--ink-strong);
    transition: background var(--dur-fast) var(--ease);
  }

  .club:hover {
    background: rgba(36, 36, 36, 0.05);
    color: var(--ink-strong);
  }

  .club :global(.club-idx) {
    display: flex;
    justify-content: space-between;
  }

  .club-name {
    margin-top: var(--u);
    font-size: var(--t-lg);
    font-weight: var(--w-semibold);
    line-height: var(--lh-grid);
  }

  .club-name.muted {
    color: var(--ink-muted);
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      gap: var(--u);
    }
  }
</style>
