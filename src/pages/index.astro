---
/**
 * Home — set as an engineering drawing.
 *
 * Each section is a numbered sheet: a title block for the programme at a
 * glance and the partners coming round on a reel, a ruled specification
 * for the flagship, a schedule drawn as a dimension line, the ways in as
 * three ruled cards, the activity log as a revision table, and the
 * partners as a roster of single-ink marks.
 *
 * The page is set on the drafting grid behind it: every block is whole
 * cells in size and every rule is painted on a grid line. The notes at
 * the top of the style block say how.
 *
 * Every figure is real: repo stats from the GitHub API at build time,
 * videos from the orgs' channel feeds, counts from the partners list.
 * The schedule's "now" marker is computed from the build date, and the
 * scheduled rebuild keeps it current.
 */
import { getCollection, getEntry } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import Figure from '../components/ui/Figure.astro';
import PartnerMark from '../components/ui/PartnerMark.astro';
import PixelField from '../components/ui/PixelField.astro';
import { CONTACTS, SITE } from '../data/site';
import { getPublicRepos } from '../lib/github';
import { getLatestPerOrg } from '../lib/youtube';
import { requireAsset } from '../lib/assets';

const [repos, videos, partners, allPosts, allFeatured] = await Promise.all([
  getPublicRepos(),
  getLatestPerOrg(),
  getCollection('partners'),
  getCollection('blog'),
  getCollection('featured'),
]);

const legStand = requireAsset('gallery/leg-test-stand.jpg', 'home');
const schoolCount = new Set(partners.map((p) => p.data.school)).size;

/* ------------------------------------------------------------------
 * H1 schedule. `starts` only places the "now" marker; the visible
 * label is the season the roadmap commits to.
 * ---------------------------------------------------------------- */
const milestones = [
  {
    starts: '2026-11-01',
    when: 'Nov 2026',
    title: 'Hardware development',
    body: 'Teams start building H1 subsystems at their home institutions.',
  },
  {
    starts: '2026-12-15',
    when: 'Winter',
    title: 'Integration workshop',
    body: 'The people behind each subsystem meet to assemble and test together.',
  },
  {
    starts: '2027-03-01',
    when: 'Spring 2027',
    title: 'Joint testing',
    body: 'Further periods of integrated testing across campuses.',
  },
  {
    starts: '2027-05-01',
    when: 'May–Jun 2027',
    title: 'H1 complete',
    body: 'A full-scale humanoid — plus the papers, videos, and code to show how.',
  },
].map((m) => ({ ...m, date: new Date(m.starts) }));

const now = new Date();
const current = milestones.findLastIndex((m) => m.date <= now);

// Position of the "now" marker along the schedule, 0..1: milestones sit at
// the start of each of four equal columns, and the marker advances between
// them by the share of time actually elapsed.
const progress = (() => {
  if (current < 0) return 0;
  if (current >= milestones.length - 1) return (milestones.length - 1) / milestones.length;
  const a = milestones[current].date.getTime();
  const b = milestones[current + 1].date.getTime();
  const within = Math.min(1, Math.max(0, (now.getTime() - a) / (b - a)));
  return (current + within) / milestones.length;
})();

const programStatus =
  current < 0 ? 'Starts Nov 2026' : current >= milestones.length - 1 ? 'Completing' : 'In progress';

const steps = [
  {
    title: 'Agree on the robot',
    body: 'Teams agree on what it should do, divide the engineering, and fix how the parts fit together.',
    output: 'Spec + interfaces',
  },
  {
    title: 'Build at home',
    body: 'Each team develops and tests its subsystem at its own institution.',
    output: 'Tested subsystems',
  },
  {
    title: 'Integrate together',
    body: 'At integration workshops, the people behind each system assemble the hardware, run tests, and trace faults across mechanical, electrical, and software boundaries.',
    output: null,
  },
];

const tracks = [
  {
    type: 'Quadruped',
    title: 'Four legs, same playbook',
    body: 'A legged platform on the 2026–27 roadmap, alongside H1.',
    level: 'Legged',
  },
  {
    type: 'Manipulator',
    title: 'Teleoperation arm',
    body: 'A robotic arm driven by a human operator — the entry point for newer participants.',
    level: 'Beginner',
  },
  {
    type: 'Manipulator',
    title: 'Precision manipulation',
    body: 'An advanced project focused on precise, controlled manipulation.',
    level: 'Advanced',
  },
];

/* ------------------------------------------------------------------
 * Ways in.
 * ---------------------------------------------------------------- */
const general = CONTACTS[0].address;
const mailto = (subject: string) => `mailto:${general}?subject=${encodeURIComponent(subject)}`;

const ways = [
  {
    ref: 'A',
    who: 'University clubs',
    title: 'Member team',
    lede: 'Take responsibility for part of a robot.',
    points: [
      'Own a subsystem on a joint build',
      'Develop and test it at your home institution',
      'Integrate with the other teams at workshops',
    ],
    cta: 'Join a build',
    href: mailto('Member team'),
  },
  {
    ref: 'B',
    who: 'Newer clubs',
    title: 'Affiliate club',
    lede: 'Join the network before you take on a build.',
    points: [
      'Exchange technical advice with experienced teams',
      'Share your team’s milestones',
      'Take part in, or co-host, workshops, conferences, and networking events',
    ],
    cta: 'Become an affiliate',
    href: mailto('Affiliate club'),
  },
  {
    ref: 'C',
    who: 'Companies & labs',
    title: 'Industry & research',
    lede: 'Support a build, or start one with us.',
    points: [
      'Provide components, loan equipment, mentor a team, or fund development',
      'Lead a workshop on a specific engineering problem',
      'Through the planned Industry Research Alliance, define a research question with students',
    ],
    cta: 'Start a conversation',
    href: mailto('Industry & research partnership'),
  },
];

/* ------------------------------------------------------------------
 * Log: posts, curated items, videos and repos, newest first.
 * ---------------------------------------------------------------- */
interface FeedItem {
  date: Date | null;
  kind: string;
  title: string;
  source: string;
  href: string;
  external: boolean;
}

const orgLabel = (org: string) => (org === 'rutgers-dynamics' ? 'Rutgers Dynamics' : 'ESRA');
const FEATURED_KIND = { linkedin: 'Link', youtube: 'Video', repo: 'Repo', link: 'Link' };

const postItems: FeedItem[] = await Promise.all(
  allPosts
    .filter((p) => !p.data.draft)
    .map(async (post) => {
      const authors = await Promise.all(post.data.authors.map((ref) => getEntry(ref)));
      return {
        date: post.data.date,
        kind: 'Post',
        title: post.data.title,
        source: authors.map((a) => a!.data.name).join(', '),
        href: `/blog/${post.id}`,
        external: false,
      };
    })
);

const feed: FeedItem[] = [
  ...postItems,
  ...allFeatured
    .filter((f) => !f.data.draft)
    .map((f) => ({
      date: f.data.date ?? null,
      kind: FEATURED_KIND[f.data.type],
      title: f.data.title,
      source: orgLabel(f.data.org),
      href: f.data.url,
      external: true,
    })),
  ...videos.map((v) => ({
    date: new Date(v.published),
    kind: 'Video',
    title: v.title,
    source: v.orgName,
    href: v.url,
    external: true,
  })),
  ...repos.slice(0, 3).map((r) => ({
    date: r.pushedAt ? new Date(r.pushedAt) : null,
    kind: 'Repo',
    title: r.name,
    // A star count only once there is one: "★0" reads as a verdict.
    source: [r.language, r.stars > 0 && `★${r.stars}`].filter(Boolean).join(' '),
    href: r.url,
    external: true,
  })),
]
  .sort((a, b) => (b.date?.getTime() ?? 0) - (a.date?.getTime() ?? 0))
  .slice(0, 7);

const isoDay = (d: Date | null) => (d ? d.toISOString().slice(0, 10) : '—');

/* ------------------------------------------------------------------
 * Partners.
 * ---------------------------------------------------------------- */
const KIND_LABEL = {
  club: 'Club',
  school: 'School',
  company: 'Company',
  organization: 'Organization',
};

/** The carousel takes about seven seconds a partner to come round. */
const reelSeconds = Math.max(28, partners.length * 7);

/**
 * The open place closes the last row of the roster, however many partners
 * there are: it spans whatever the row has left, and a whole row of its
 * own when the partners fill theirs exactly. One span per column count.
 */
const openSpan = (cols: number) => cols - (partners.length % cols);
const openSpans = [5, 3, 2].map((c) => `--span-${c}: ${openSpan(c)}`).join('; ');
---

<BaseLayout sourcePath="site/index.astro">
  <!-- ============================================================
       Hero — the headline, and the programme's title block
       ============================================================ -->
  <Section pad="open">
    <PixelField
      slot="backdrop"
      side="end"
      overlap={16}
      cols={30}
      rows={11}
      focus={[18, 0]}
      radius={[13, 10]}
      lit={4}
      seed={11}
      keepNarrow
    />

    <div class="hero">
      <div class="hero-copy">
        <p class="kicker on-grid">Experimental Student Robotics Association</p>

        <h1 class="on-grid">One robot.<br /><span class="accent">Many campuses.</span></h1>

        <p class="lede on-grid">
          ESRA is a national nonprofit that connects university robotics teams&nbsp;— to share what
          they learn, split the engineering, and build robots no single campus could build alone.
        </p>

        <div class="actions">
          <a class="btn" href="#join" style="--cells: 9">
            Get involved <span class="arrow">&#8594;</span>
          </a>
          <a class="btn ghost" href="#h1" style="--cells: 6">Meet H1</a>
        </div>
      </div>

      <div class="title-block frame" data-reveal>
        <div class="tb-head">
          <span>Programme summary</span>
          <span>Since {SITE.established}</span>
        </div>
        <dl class="tb-grid">
          <div style="--i: 0">
            <dt>Flagship</dt>
            <dd>H1 humanoid</dd>
          </div>
          <div style="--i: 1">
            <dt>Status</dt>
            <dd><span class="live" aria-hidden="true"></span>{programStatus}</dd>
          </div>
          <div style="--i: 2">
            <dt>Hardware start</dt>
            <dd>Nov 2026</dd>
          </div>
          <div style="--i: 3">
            <dt>Target</dt>
            <dd>May–Jun 2027</dd>
          </div>
          <div style="--i: 4">
            <dt>Partners</dt>
            <dd>{partners.length}</dd>
          </div>
          <div style="--i: 5">
            <dt>Schools</dt>
            <dd>{schoolCount}</dd>
          </div>
          <div class="full" style="--i: 6">
            <dt>Licence</dt>
            <dd>{SITE.license}</dd>
          </div>
        </dl>
      </div>
    </div>

    <!-- The partners, coming round on a reel. The list is set twice so the
         loop has no seam; the second copy is hidden from assistive tech
         and from the keyboard. It stops under the pointer, on focus, with
         the pause control, and for anyone who asks for reduced motion. -->
    <div class="reel-band" data-reveal>
      <div class="reel-label">
        <span class="label">Built with</span>
        <button class="reel-toggle" type="button" aria-pressed="false" data-reel-toggle hidden>
          <span class="sr-only">Pause the partner carousel</span>
          <span class="reel-icon" aria-hidden="true"></span>
        </button>
      </div>

      <div class="reel" data-reel style={`--reel-time: ${reelSeconds}s`}>
        <div class="reel-view">
          {
            [false, true].map((copy) => (
              <ul class="reel-track" aria-hidden={copy ? 'true' : undefined}>
                {partners.map((p) => (
                  <li>
                    <a
                      href={p.data.url}
                      rel="noopener"
                      target="_blank"
                      tabindex={copy ? -1 : undefined}
                    >
                      <PartnerMark partner={p} height={32} maxWidth={64} decorative />
                      <span class="reel-name">{p.data.name}</span>
                    </a>
                  </li>
                ))}
              </ul>
            ))
          }
        </div>
      </div>

      <a class="reel-all" href="#partners">
        <span class="label">All {partners.length} partners</span>
        <span aria-hidden="true">&#8595;</span>
      </a>
    </div>
  </Section>

  <!-- ============================================================
       01 — Why: the problem, and how a joint build answers it
       ============================================================ -->
  <Section id="why">
    <SectionHead index="01" title="Why ESRA" />

    <div class="why">
      <div class="why-copy" data-reveal>
        <p class="statement on-grid">Every campus is debugging the same robot alone.</p>
        <p class="body">
          One team spends a semester learning to control a robot’s joints while another works
          through the same problem, with little chance to compare notes. ESRA connects student-led
          robotics clubs with each other, and with research labs, engineers, and companies.
        </p>
        <p class="body">
          We coordinate joint builds, run technical workshops, and help teams find mentorship,
          equipment, and funding.
        </p>

        <aside class="note">
          <span class="label">Example</span>
          <p>
            On H1, the leg team needs its actuators’ dimensions and torque. The controller team
            needs to know how those joints move and what the sensors report. A joint build makes
            those handoffs explicit.
          </p>
        </aside>
      </div>

      <div class="why-fig" data-reveal style="--reveal-i: 1">
        <Figure
          src={legStand}
          alt="The leg test stand, assembled on a linear slide."
          plate="FIG. 1"
          ref="LEG TEST STAND"
          ratio="4/5"
          width={720}
          caption="Leg test stand — design Luis Serrano Laguna, photo Ryan Rudes."
        />
      </div>
    </div>

    <div class="process" data-draw>
      <p class="label">How a joint build works</p>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="step" style={`--i: ${i}`}>
              <span class="step-no">Step {i + 1}</span>
              <strong>{s.title}</strong>
              <p>{s.body}</p>
              {s.output && (
                <span class="step-out">
                  <span aria-hidden="true">&#8594;</span> {s.output}
                </span>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </Section>

  <!-- ============================================================
       02 — H1: the flagship, as a specification and a schedule
       ============================================================ -->
  <Section id="h1" tone="panel">
    <SectionHead index="02" title="Flagship programme" aside="2026–27 roadmap" />

    <div class="program">
      <div class="program-copy" data-reveal>
        <p class="designation" aria-hidden="true">H1</p>
        <p class="statement on-grid">A full-scale humanoid, built across campuses.</p>
        <p class="body">
          H1 brings mechanical structures, actuators, electronics, sensing, and control software
          together in one robot — designed, built, and tested by teams at different universities.
        </p>
      </div>

      <table class="spec" data-reveal style="--reveal-i: 1">
        <caption>H1 &middot; Specification</caption>
        <tbody>
          <tr>
            <th scope="row">Status</th>
            <td><span class="live" aria-hidden="true"></span>{programStatus}</td>
          </tr>
          <tr>
            <th scope="row">Type</th>
            <td>Humanoid, full-scale</td>
          </tr>
          <tr>
            <th scope="row">Subsystems</th>
            <td>Structure, actuators, electronics, sensing, control</td>
          </tr>
          <tr>
            <th scope="row">Hardware start</th>
            <td>November 2026</td>
          </tr>
          <tr>
            <th scope="row">Target</th>
            <td>May–June 2027</td>
          </tr>
          <tr>
            <th scope="row">Outputs</th>
            <td>
              Technical papers, engineering videos, progress reports,
              <span class="nowrap">open-source</span> code
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="schedule" style={`--progress: ${progress};`} data-draw>
      <p class="label">Schedule</p>
      <div class="dim" aria-hidden="true">
        <span class="dim-ruler"></span>
        <span class="dim-done"></span>
        {current >= 0 && <span class="dim-now">Now</span>}
      </div>
      <ol class="stops">
        {
          milestones.map((m, i) => (
            <li
              class:list={['stop', { done: i < current, current: i === current }]}
              style={`--i: ${i}`}
            >
              <span class="stop-ref">
                M{i + 1}
                {i === current && <span class="now-tag">Now</span>}
              </span>
              <span class="stop-when">{m.when}</span>
              <strong>{m.title}</strong>
              <p>{m.body}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="tracks">
      <SectionHead as="h3" title="Also on the roadmap" />
      <div class="track-grid">
        {
          tracks.map((t, i) => (
            <article class="track frame" data-reveal style={`--reveal-i: ${i}`}>
              <div class="track-meta">
                <span class="label">{t.type}</span>
                <span class="tag">{t.level}</span>
              </div>
              <strong>{t.title}</strong>
              <p>{t.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- ============================================================
       03 — Ways in, as three ruled cards
       ============================================================ -->
  <Section id="join">
    <PixelField
      slot="backdrop"
      side="end"
      overlap={12}
      cols={24}
      rows={8}
      focus={[14, 0]}
      radius={[11, 7]}
      lit={3}
      seed={5}
    />

    <SectionHead index="03" title="Get involved" />

    <div class="lead" data-reveal>
      <p class="statement wide on-grid">Three ways in. Start where your team fits.</p>
    </div>

    <div class="ways">
      {
        ways.map((w, i) => (
          <article class="way frame" data-reveal style={`--reveal-i: ${i}`}>
            <div class="way-top">
              <span class="way-ref">{w.ref}</span>
              <span class="label">{w.who}</span>
            </div>
            <h3>{w.title}</h3>
            <p class="way-lede">{w.lede}</p>
            <ul>
              {w.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
            <a class="btn sm ghost" href={w.href}>
              {w.cta} <span class="arrow">&#8594;</span>
            </a>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- ============================================================
       04 — The log, as a revision table
       ============================================================ -->
  {
    feed.length > 0 && (
      <Section id="log">
        <SectionHead index="04" title="Log">
          <a slot="aside" href="/blog">
            All posts &#8594;
          </a>
        </SectionHead>

        <div class="log" data-draw>
          <div class="log-head" aria-hidden="true">
            <span>Date</span>
            <span>Type</span>
            <span>Entry</span>
            <span>Source</span>
          </div>
          <ul>
            {feed.map((item, i) => (
              <li style={`--i: ${i}`}>
                <a
                  href={item.href}
                  rel={item.external ? 'noopener' : undefined}
                  target={item.external ? '_blank' : undefined}
                >
                  <span class="l-date">
                    {item.date ? (
                      <time datetime={item.date.toISOString()}>{isoDay(item.date)}</time>
                    ) : (
                      isoDay(null)
                    )}
                  </span>
                  <span class="l-kind">{item.kind}</span>
                  <span class="l-title">{item.title}</span>
                  <span class="l-src">{item.source}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </Section>
    )
  }

  <!-- ============================================================
       05 — Partners: a roster of tiles, every logo in the site's ink
       ============================================================ -->
  <Section id="partners" last>
    <SectionHead
      index="05"
      title="Partners"
      aside={`${partners.length} partners · ${schoolCount} schools`}
    />

    <div class="lead" data-reveal>
      <p class="statement wide on-grid">The clubs and schools in the network.</p>
    </div>

    <div class="roster" style={openSpans} data-reveal>
      {
        partners.map((p) => (
          <a class="tile" href={p.data.url} rel="noopener" target="_blank">
            <div class="tile-top">
              <span class="label">{KIND_LABEL[p.data.kind]}</span>
              <span class="tile-go" aria-hidden="true">
                &#8599;
              </span>
            </div>
            <div class="tile-mark">
              <PartnerMark partner={p} height={72} maxWidth={144} decorative />
            </div>
            <div class="tile-name">{p.data.name}</div>
            <div class="tile-meta label">
              {p.data.kind !== 'school' && <span>{p.data.school}</span>}
              {p.data.location && <span>{p.data.location}</span>}
            </div>
          </a>
        ))
      }
      <a class="tile open" href="#join">
        <div class="open-in">
          <div class="open-slot" aria-hidden="true"></div>
          <div class="open-copy">
            <div class="tile-name">Your team here</div>
            <div class="label">Clubs, labs and companies welcome</div>
          </div>
          <span class="open-go">
            Get involved <span class="arrow" aria-hidden="true">&#8594;</span>
          </span>
        </div>
      </a>
    </div>
  </Section>
</BaseLayout>

<script is:inline>
  // The carousel's pause control, and a gentle stop. Without JS the reel
  // still stops under the pointer and on focus (instantly, in CSS), so the
  // button is only shown once this runs.
  //
  // With JS the reel coasts to a stop rather than freezing: its speed is
  // eased down to nothing under the pointer, on focus or on pause, and
  // eased back up afterwards. data-eased hands the stopping over from the
  // CSS rules to this script.
  (function () {
    var reel = document.querySelector('[data-reel]');
    var toggle = document.querySelector('[data-reel-toggle]');
    if (!reel || !toggle) return;
    toggle.hidden = false;

    // None under reduced motion (the reel is a static strip then).
    var anims = reel.getAnimations ? reel.getAnimations({ subtree: true }) : [];
    var held = { hover: false, focus: false, paused: false };
    var rate = 1;
    var raf = 0;

    var STOP_MS = 450; // quick, but you see it slow
    var START_MS = 700; // pick up speed a little more gently

    function setRate(r) {
      rate = r;
      anims.forEach(function (a) {
        a.playbackRate = r;
      });
    }

    function settle() {
      var to = held.hover || held.focus || held.paused ? 0 : 1;
      var from = rate;
      if (from === to) return;
      cancelAnimationFrame(raf);
      var dur = (to === 0 ? STOP_MS : START_MS) * Math.abs(to - from);
      var start = performance.now();
      raf = requestAnimationFrame(function frame(now) {
        var t = Math.min(1, (now - start) / dur);
        // Stopping: ease-out, most of the speed shed at once, then a short
        // coast. Starting: ease-in-out, so it never lurches.
        var k = to === 0 ? 1 - (1 - t) * (1 - t) : t * t * (3 - 2 * t);
        setRate(from + (to - from) * k);
        if (t < 1) raf = requestAnimationFrame(frame);
      });
    }

    function hold(key, on) {
      held[key] = on;
      settle();
    }

    toggle.addEventListener('click', function () {
      held.paused = !held.paused;
      reel.toggleAttribute('data-paused', held.paused);
      toggle.setAttribute('aria-pressed', String(held.paused));
      settle();
    });

    if (!anims.length) return;
    reel.setAttribute('data-eased', '');
    reel.addEventListener('pointerenter', function () {
      hold('hover', true);
    });
    reel.addEventListener('pointerleave', function () {
      hold('hover', false);
    });
    reel.addEventListener('focusin', function () {
      hold('focus', true);
    });
    reel.addEventListener('focusout', function (e) {
      if (!reel.contains(e.relatedTarget)) hold('focus', false);
    });
  })();
</script>

<style>
  /*
   * Everything on this page is set on the drafting grid behind it.
   *
   *   - Every block is whole cells (24px) wide and tall, so nothing below
   *     it is pushed off a line.
   *   - Rules are painted on grid lines with box-shadow or .frame, never
   *     laid out as borders (see "Rules" in global.css).
   *   - Columns are cut with the --col-* tracks, which round to whole
   *     cells at any width.
   *   - Display type (.on-grid) sits with its baseline on a line. Running
   *     text fills its row; single-line table rows are two cells tall and
   *     centre their text on the line between.
   */

  /* ============================================================
     Shared
     ============================================================ */
  .accent {
    color: var(--accent-ink);
  }

  .statement {
    --lh: var(--lh-h1);
    margin: 0;
    max-width: calc(25 * var(--u));
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: var(--w-semibold);
    line-height: var(--lh);
    letter-spacing: var(--track-tight);
    color: var(--ink-strong);
    text-wrap: balance;
  }

  .statement.wide {
    max-width: calc(32 * var(--u));
  }

  .lead {
    margin-bottom: var(--u-2);
  }

  /* Running text is set in sans and kept bright: the mono and the muted
     ink are for data and labels, not for sentences. */
  .body {
    margin: var(--u) 0 0;
    max-width: calc(25 * var(--u));
    font-family: var(--font-text);
    font-size: var(--t-text);
    line-height: var(--lh-grid);
    color: var(--ink-body);
  }

  /* A small square that marks the one live value on the page. */
  .live {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 10px;
    background: var(--signal);
    /* Nudged with position, not vertical-align, which would grow the line. */
    position: relative;
    top: -1px;
  }

  .nowrap {
    white-space: nowrap;
  }

  /* ============================================================
     Motion (see "Depth and motion" in tokens.css)
     ============================================================ */
  @media screen and (prefers-reduced-motion: no-preference) {
    /* The status lamp: lit, with a short dip every few seconds — stepped,
       like an indicator LED, not a pulse. Both lamps keep time. */
    .live {
      animation: lamp 2.4s steps(1, end) infinite;
    }

    /* The title block arrives as a blank form; its values are then
       filled in one field at a time. */
    :global(.js) .title-block:not(.revealed) dd {
      opacity: 0;
    }

    .title-block.revealed dd {
      animation: appear 1ms backwards;
      animation-delay: calc(0.4s + var(--i) * 90ms);
    }

    /*
     * The two ruled sequences — how a joint build works, and the schedule.
     * The rule is drawn from the left; each tick is struck as the pen
     * passes it (--at, below), and its column settles in just after.
     * Hidden states scale to 0 on both axes so they hold whichever way
     * the rule runs.
     */
    :global(.js) .process:not(.revealed) .steps::before,
    :global(.js) .process:not(.revealed) .step::before,
    :global(.js) .schedule:not(.revealed) .stops::before,
    :global(.js) .schedule:not(.revealed) .stop::before {
      scale: 0;
    }

    :global(.js) .process:not(.revealed) .step > *,
    :global(.js) .schedule:not(.revealed) .stop > *,
    :global(.js) .schedule:not(.revealed) .dim > * {
      opacity: 0;
    }

    .process.revealed .steps::before,
    .schedule.revealed .stops::before {
      animation: draw-x var(--dur-draw) var(--ease-draw) backwards;
    }

    .process.revealed .step::before,
    .schedule.revealed .stop::before {
      animation: draw-y 0.2s var(--ease-out) var(--at, 0s) backwards;
    }

    .process.revealed .step > *,
    .schedule.revealed .stop > * {
      animation: settle var(--dur-settle) var(--ease-out) backwards;
      animation-delay: calc(var(--at, 0s) + 0.1s);
    }

    /* When the pen passes each tick, for --ease-draw over --dur-draw. */
    .step:nth-child(2) {
      --at: 0.35s;
    }
    .step:nth-child(3) {
      --at: 0.45s;
    }
    .stop:nth-child(2) {
      --at: 0.32s;
    }
    .stop:nth-child(3) {
      --at: 0.4s;
    }
    .stop:nth-child(4) {
      --at: 0.51s;
    }

    /* Once the line is drawn, the progress made runs out along it to the
       "now" marker, which rides at its head. */
    .schedule.revealed .dim-done {
      animation: progress 0.9s var(--ease-out) 0.7s backwards;
    }

    .schedule.revealed .dim-now {
      animation: progress-now 0.9s var(--ease-out) 0.7s backwards;
    }

    /* The ruler is graduated as the pen goes, a whole tick at a time, then
       its ticks turn blue as the progress runs over them. */
    .schedule.revealed .dim-ruler {
      animation:
        graduate var(--dur-draw) var(--ease-draw) backwards,
        fill 0.9s var(--ease-out) 0.7s backwards;
    }

    /* Run down the page, the schedule's rule is drawn downwards. */
    @media (max-width: 900px) {
      .schedule.revealed .stops::before {
        animation-name: draw-y;
      }
    }

    /* The log prints a line at a time, newest first. */
    :global(.js) .log:not(.revealed) li {
      opacity: 0;
    }

    .log.revealed li {
      animation: appear 1ms backwards;
      animation-delay: calc(0.15s + var(--i) * 70ms);
    }
  }

  @keyframes lamp {
    80% {
      opacity: 0.35;
    }
  }

  @keyframes progress {
    from {
      width: 0;
    }
  }

  @keyframes graduate {
    from {
      --drawn: 0%;
    }
  }

  @keyframes fill {
    from {
      --fill: 0%;
    }
  }

  @keyframes progress-now {
    from {
      left: 0;
      opacity: 0;
    }
  }

  /* ============================================================
     Hero
     ============================================================ */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) calc(18 * var(--u));
    gap: var(--u-2) var(--u-3);
    align-items: end;
  }

  .kicker {
    margin: 0;
    font-family: var(--font-pixel);
    font-size: var(--t-pixel);
    font-weight: var(--w-regular);
    line-height: var(--lh-grid);
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  h1 {
    margin: var(--u) 0 0;
    font-family: var(--font-display);
    font-size: 80px;
    font-weight: var(--w-semibold);
    --lh: 96px;
    line-height: var(--lh);
    letter-spacing: -0.035em;
    color: var(--ink-strong);
  }

  .lede {
    margin: var(--u) 0 0;
    max-width: calc(23 * var(--u));
    font-family: var(--font-sans);
    font-size: 18px;
    line-height: var(--lh-grid);
    color: var(--ink-body);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--u);
    margin-top: var(--u-2);
  }

  /* --- title block ------------------------------------------------ */
  .title-block {
    --frame-color: var(--rule-strong);
    background: var(--sheet-glass);
  }

  .tb-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 var(--u-half);
    white-space: nowrap;
    padding: var(--u-half) var(--u);
    font-size: var(--t-micro);
    font-weight: var(--w-medium);
    line-height: var(--lh-grid);
    letter-spacing: var(--track-mono-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .tb-head span:first-child {
    font-family: var(--font-pixel);
    font-size: var(--t-pixel);
    font-weight: var(--w-regular);
    letter-spacing: 0;
    color: var(--ink-strong);
  }

  .tb-grid {
    display: grid;
    grid-template-columns: round(down, 50%, var(--u)) minmax(0, 1fr);
    margin: 0;
  }

  .tb-grid > div {
    padding: var(--u-half) var(--u);
    box-shadow: inset 0 var(--rule-width) 0 var(--rule);
  }

  .tb-grid > div:nth-child(even):not(.full) {
    box-shadow:
      inset 0 var(--rule-width) 0 var(--rule),
      inset var(--rule-width) 0 0 var(--rule);
  }

  .tb-grid .full {
    grid-column: 1 / -1;
  }

  .tb-grid dt {
    font-size: var(--t-micro);
    font-weight: var(--w-medium);
    line-height: var(--lh-grid);
    letter-spacing: var(--track-mono-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .tb-grid dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--t-lg);
    font-weight: var(--w-semibold);
    line-height: var(--lh-grid);
    color: var(--ink-strong);
  }

  /* --- partner reel ---------------------------------------------- */
  /* A ruled band along the foot of the hero: a label cell, the reel, and
     a link cell, divided on grid lines. */
  .reel-band {
    display: grid;
    grid-template-columns: calc(7 * var(--u)) minmax(0, 1fr) calc(8 * var(--u));
    height: var(--u-4);
    margin-top: var(--u-3);
    box-shadow: inset 0 var(--rule-width) 0 var(--rule);
  }

  .reel-label,
  .reel-all {
    display: flex;
    align-items: center;
    gap: var(--u-half);
  }

  /* One cell square; the icon is drawn in art pixels. */
  .reel-toggle {
    display: grid;
    place-items: center;
    width: var(--u);
    height: var(--u);
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink-muted);
    cursor: pointer;
    transition: color var(--dur) var(--ease);
  }

  .reel-toggle:hover {
    color: var(--accent-ink);
  }

  .reel-toggle[hidden] {
    display: none;
  }

  /* Two bars for pause; a stepped triangle for play. */
  .reel-icon {
    width: 10px;
    height: 10px;
    background:
      linear-gradient(currentColor, currentColor) left / 4px 100% no-repeat,
      linear-gradient(currentColor, currentColor) right / 4px 100% no-repeat;
  }

  .reel-toggle[aria-pressed='true'] .reel-icon {
    background: currentColor;
    clip-path: polygon(
      0 0,
      4px 0,
      4px 2px,
      8px 2px,
      8px 4px,
      10px 4px,
      10px 6px,
      8px 6px,
      8px 8px,
      4px 8px,
      4px 10px,
      0 10px
    );
  }

  .reel {
    min-width: 0;
    box-shadow: inset var(--rule-width) 0 0 var(--rule);
  }

  /* The window the reel passes behind, faded at both ends. */
  .reel-view {
    --reel-gap: var(--u-3);
    display: flex;
    gap: var(--reel-gap);
    height: 100%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent,
      #000 72px,
      #000 calc(100% - 72px),
      transparent
    );
    mask-image: linear-gradient(90deg, transparent, #000 72px, #000 calc(100% - 72px), transparent);
  }

  /* Each copy is at least as wide as the window, so two always cover it
     however few partners there are. */
  .reel-track {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-around;
    gap: var(--reel-gap);
    min-width: 100%;
    list-style: none;
    margin: 0;
    padding: 0;
    animation: reel var(--reel-time, 40s) linear infinite;
  }

  @keyframes reel {
    to {
      transform: translateX(calc(-100% - var(--reel-gap)));
    }
  }

  /* Without JS, stop dead. With it (data-eased), the script eases the
     reel to a stop instead. */
  .reel:not([data-eased]):hover .reel-track,
  .reel:not([data-eased]):focus-within .reel-track,
  .reel:not([data-eased])[data-paused] .reel-track {
    animation-play-state: paused;
  }

  .reel-track a {
    display: flex;
    align-items: center;
    gap: var(--u-half);
    height: var(--u-2);
    color: var(--ink-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur) var(--ease);
  }

  .reel-track a:hover,
  .reel-track a:focus-visible {
    color: var(--accent-ink);
  }

  .reel-name {
    font-size: var(--t-micro);
    font-weight: var(--w-medium);
    line-height: var(--lh-grid);
    letter-spacing: var(--track-mono-label);
    text-transform: uppercase;
  }

  .reel-all {
    justify-content: flex-end;
    color: var(--ink-muted);
    text-decoration: none;
    box-shadow: inset var(--rule-width) 0 0 var(--rule);
    transition:
      color var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }

  .reel-all .label {
    color: inherit;
  }

  .reel-all:hover {
    color: var(--accent-ink);
  }

  /* No motion: the reel becomes a strip you scroll yourself. */
  @media (prefers-reduced-motion: reduce) {
    .reel-view {
      overflow-x: auto;
      scrollbar-width: none;
    }

    .reel-track {
      justify-content: flex-start;
      padding-inline: var(--u-3);
      animation: none;
    }

    .reel-track[aria-hidden] {
      display: none;
    }

    .reel-toggle {
      display: none;
    }
  }

  /* ============================================================
     01 — Why
     ============================================================ */
  .why {
    display: grid;
    grid-template-columns: minmax(0, 1fr) round(down, 40%, var(--u));
    gap: var(--u-2) var(--u-3);
    align-items: start;
  }

  .note {
    max-width: calc(26 * var(--u));
    margin-top: var(--u-2);
    padding-left: var(--u);
    box-shadow: inset 2px 0 0 var(--accent);
  }

  .note .label {
    display: block;
  }

  .note p {
    margin: 0;
    font-family: var(--font-text);
    font-size: var(--t-text-sm);
    line-height: var(--lh-grid);
    color: var(--ink-body);
  }

  .process {
    margin-top: var(--u-3);
  }

  .process > .label,
  .schedule > .label {
    margin: 0;
  }

  .steps {
    position: relative;
    display: grid;
    grid-template-columns: var(--col-3) var(--col-3) minmax(0, 1fr);
    column-gap: var(--u);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* The rule both sequences hang from, on the grid line at their top edge
     (where an inset box-shadow would paint it). An element, so it can be
     drawn in. */
  .steps::before,
  .stops::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--rule-width);
    background: var(--rule-strong);
    transform-origin: left;
  }

  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-top: var(--u);
  }

  /* A tick where each step starts, crossing the rule like a dimension mark. */
  .step::before,
  .stop::before {
    content: '';
    position: absolute;
    top: -6px;
    left: 0;
    width: var(--rule-width);
    height: 13px;
    background: var(--ink-strong);
  }

  .step-no {
    font-family: var(--font-pixel);
    font-size: var(--t-pixel);
    font-weight: var(--w-regular);
    line-height: var(--lh-grid);
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  .step strong,
  .stop strong,
  .track strong {
    display: block;
    font-family: var(--font-display);
    font-size: var(--t-xl);
    font-weight: var(--w-semibold);
    line-height: var(--lh-grid);
    letter-spacing: var(--track-snug);
    color: var(--ink-strong);
  }

  .step p,
  .stop p,
  .track p {
    margin: 0;
    max-width: calc(16 * var(--u));
    font-family: var(--font-text);
    font-size: var(--t-text-sm);
    line-height: var(--lh-grid);
    color: var(--ink-body);
  }

  .step-out {
    margin-top: var(--u);
    font-size: var(--t-micro);
    font-weight: var(--w-medium);
    line-height: var(--lh-grid);
    letter-spacing: var(--track-widest);
    text-transform: uppercase;
    color: var(--ink-strong);
  }

  /* ============================================================
     02 — H1
     ============================================================ */
  .program {
    display: grid;
    grid-template-columns: minmax(0, 1fr) round(down, 50%, var(--u));
    gap: var(--u-2) var(--u-3);
    align-items: end;
  }

  /*
   * The designation is drawn in outline, like a part on a drawing — and
   * at this size one pixel of the lettering is exactly one grid cell, so
   * its outline traces the drafting grid. Silkscreen is drawn eight
   * pixels to the em with one pixel of left bearing; the shift sets its
   * baseline on the grid line at the foot of the box (0.39 is the face's
   * baseline constant, as --bl-k is for Plex).
   */
  .designation {
    --lh: calc(5 * var(--u));
    height: var(--lh);
    margin: 0 0 var(--u) calc(-1 * var(--u));
    font-family: var(--font-pixel);
    font-size: calc(8 * var(--u));
    font-weight: var(--w-bold);
    line-height: var(--lh);
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 2px var(--accent);
    transform: translateY(calc(var(--lh) / 2 - 0.39em));
  }

  @supports not (-webkit-text-stroke: 1px black) {
    .designation {
      color: var(--accent-ink);
    }
  }

  .spec {
    width: 100%;
    border-collapse: collapse;
  }

  .spec caption {
    font-family: var(--font-pixel);
    font-size: var(--t-pixel);
    font-weight: var(--w-regular);
    line-height: var(--lh-grid);
    text-align: left;
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  .spec th,
  .spec td {
    padding: var(--u-half) 0;
    line-height: var(--lh-grid);
    text-align: left;
    vertical-align: top;
    box-shadow: inset 0 var(--rule-width) 0 var(--rule);
  }

  .spec tr:first-child > * {
    box-shadow: inset 0 var(--rule-width) 0 var(--rule-strong);
  }

  .spec tr:last-child > * {
    box-shadow:
      inset 0 var(--rule-width) 0 var(--rule),
      0 var(--rule-width) 0 var(--rule-strong);
  }

  .spec th {
    width: calc(7 * var(--u));
    padding-right: var(--u);
    font-size: var(--t-micro);
    font-weight: var(--w-medium);
    letter-spacing: var(--track-mono-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .spec td {
    font-family: var(--font-text);
    font-size: var(--t-text-sm);
    color: var(--ink-strong);
  }

  /* --- schedule: a dimension line with a computed "now" ---------- */
  .schedule {
    margin-top: var(--u-3);
  }

  .dim {
    position: relative;
    height: var(--u-2);
  }

  /* Both hang on the schedule's rule: the grid line at the foot of .dim. */
  .dim-done {
    position: absolute;
    left: 0;
    bottom: -2px;
    z-index: 1;
    width: calc(var(--progress) * 100%);
    height: 3px;
    background: var(--signal);
  }

  /*
   * The ruler: unnumbered graduations standing on the schedule's rule —
   * a fine tick every half cell, a taller one every five, the tallest
   * every ten, on the drafting grid's heavy lines. Ticks behind "now" are
   * blue, ticks still ahead are grey.
   *
   * The ticks are a mask; the colour behind them is split at --fill, so
   * one boundary does the blue/grey for every tick. --drawn is how much
   * of the ruler is showing, rounded down to whole ticks (see Motion).
   */
  @property --fill {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 0%;
  }

  @property --drawn {
    syntax: '<length-percentage>';
    inherits: false;
    initial-value: 0%;
  }

  .dim-ruler {
    --tick: var(--u-half);
    --fill: calc(var(--progress) * 100%);
    --drawn: 100%;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 8px;
    background: linear-gradient(
      90deg,
      var(--signal) var(--fill),
      var(--ink-faint) var(--fill)
    );
    --_t: #000 0 var(--rule-width), transparent var(--rule-width);
    -webkit-mask:
      repeating-linear-gradient(90deg, var(--_t) var(--tick)) left bottom / 100% 4px no-repeat,
      repeating-linear-gradient(90deg, var(--_t) calc(5 * var(--tick))) left bottom / 100% 6px
        no-repeat,
      repeating-linear-gradient(90deg, var(--_t) calc(10 * var(--tick))) left bottom / 100% 8px
        no-repeat;
    mask:
      repeating-linear-gradient(90deg, var(--_t) var(--tick)) left bottom / 100% 4px no-repeat,
      repeating-linear-gradient(90deg, var(--_t) calc(5 * var(--tick))) left bottom / 100% 6px
        no-repeat,
      repeating-linear-gradient(90deg, var(--_t) calc(10 * var(--tick))) left bottom / 100% 8px
        no-repeat;
    clip-path: inset(0 calc(100% - round(down, var(--drawn), var(--tick)) - 1px) 0 0);
  }

  .dim-now {
    position: absolute;
    left: calc(var(--progress) * 100%);
    bottom: -2px;
    z-index: 1;
    height: 30px;
    padding-left: 8px;
    border-left: var(--rule-width) solid var(--signal);
    font-size: var(--t-micro);
    font-weight: var(--w-semibold);
    line-height: 18px; /* sub-grid: a marker label hanging off the schedule line */
    letter-spacing: var(--track-mono-label);
    text-transform: uppercase;
    color: var(--signal);
  }

  .stops {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, var(--col-4)) minmax(0, 1fr);
    column-gap: var(--u-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .stop {
    position: relative;
    padding-top: var(--u);
  }

  /* Milestone ticks follow the ruler: blue once reached, grey ahead. */
  .stop::before {
    background: var(--ink-soft);
  }

  .stop.done::before,
  .stop.current::before {
    background: var(--signal);
  }

  .stop-ref,
  .stop-when {
    display: block;
    font-size: var(--t-micro);
    font-weight: var(--w-medium);
    line-height: var(--lh-grid);
    letter-spacing: var(--track-mono-label);
    text-transform: uppercase;
  }

  .stop-ref {
    font-family: var(--font-pixel);
