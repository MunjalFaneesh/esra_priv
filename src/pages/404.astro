---
/**
 * 404, in the diagnostic register rather than an apology.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import MonoLabel from '../components/ui/MonoLabel.astro';
import { NAV } from '../data/site';
---

<BaseLayout title="404 — not found" sourcePath="site/404.astro" noindex>
  <Section pad="hero" last>
    <MonoLabel as="div" size="sm" track="label">Error · 404</MonoLabel>
    <h1>No such<br />resource.</h1>
    <p class="lede">
      The path you requested isn't here. It may have moved when the site was rebuilt, or it may
      never have existed.
    </p>

    <MonoLabel as="div" size="micro" track="wide" class="paths">Try one of these</MonoLabel>
    <ul class="links">
      {
        NAV.filter((n) => !n.mono).map(({ label, href }) => (
          <li>
            <a href={href}>{href}</a> — {label}
          </li>
        ))
      }
    </ul>
  </Section>
</BaseLayout>

<style>
  h1 {
    margin: var(--u) 0 0;
    font-family: var(--font-display);
    font-size: var(--t-display);
    font-weight: var(--w-bold);
    line-height: var(--lh-h1);
    letter-spacing: var(--track-snug);
    text-transform: uppercase;
  }

  .lede {
    margin: var(--u) 0 0;
    max-width: 456px;
    font-size: var(--t-md);
    line-height: var(--lh-grid);
    color: var(--ink-body);
  }

  :global(.paths) {
    display: block;
    margin-top: var(--u-2);
  }

  .links {
    list-style: none;
    margin: var(--u-half) 0 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    line-height: var(--lh-grid);
    color: var(--ink-muted);
  }
</style>
