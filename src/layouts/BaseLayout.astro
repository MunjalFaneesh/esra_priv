---
/**
 * The single HTML shell. Every page renders through this.
 *
 * Owns the document head (meta, Open Graph, structured data), the sheet,
 * and the header/footer chrome — so a new page is just content.
 */
import '../styles/global.css';

import Sheet from '../components/ui/Sheet.astro';
import Colophon from '../components/ui/Colophon.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { SITE, SITE_URL } from '../data/site';
import { ESRA, RUTGERS_DYNAMICS } from '../data/orgs';

interface Props {
  title?: string;
  description?: string;
  /** Repo-relative source path shown in the colophon. */
  sourcePath?: string;
  /** OG image URL. Falls back to the generated per-page card. */
  image?: string;
  /** `article` for blog posts, else `website`. */
  type?: 'website' | 'article';
  publishedAt?: Date;
  /** Suppress the baseline-grid overlay. */
  grid?: boolean;
  wide?: boolean;
  /** Omit the standard header (used by minimal pages). */
  bare?: boolean;
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  sourcePath = 'site/index.astro',
  image,
  type = 'website',
  publishedAt,
  grid = true,
  wide = false,
  bare = false,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = new URL(image ?? '/og-default.png', SITE_URL).href;
const current = Astro.url.pathname;

// Organisation schema, so search and social surfaces resolve the rebrand
// and the full account graph rather than guessing.
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: ESRA.fullName,
  alternateName: [ESRA.name, ESRA.formerly].filter(Boolean),
  url: SITE_URL,
  description: ESRA.blurb,
  sameAs: [...ESRA.links, ...RUTGERS_DYNAMICS.links]
    .filter((l) => l.platform !== 'email' && !l.url.startsWith(SITE_URL))
    .map((l) => l.url),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} — all updates`}
      href="/rss.xml"
    />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Arms the scroll-reveal styles. Set before first paint so nothing
         flashes; without JS, [data-reveal] content is simply visible. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <Sheet grid={grid} wide={wide}>
      <Colophon path={sourcePath} />
      {!bare && <Header current={current} />}

      <main id="main">
        <slot />
      </main>

      <Footer path={sourcePath} />
    </Sheet>

    <!-- Arrivals (see global.css). Inline and dependency-free; if anything
         here fails, the catch reveals everything rather than leaving
         content hidden. -->
    <script is:inline>
      (function () {
        var els = document.querySelectorAll('[data-reveal], [data-draw]');
        var show = function (el) {
          el.classList.add('revealed');
        };
        try {
          if (!('IntersectionObserver' in window)) throw 0;
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (e) {
                if (e.isIntersecting) {
                  show(e.target);
                  io.unobserve(e.target);
                }
              });
            },
            { rootMargin: '0px 0px -6% 0px' }
          );
          els.forEach(function (el) {
            io.observe(el);
          });
        } catch (_) {
          els.forEach(show);
        }
      })();
    </script>
  </body>
</html>
