---
/**
 * Self-hosted video in a figure plate.
 *
 * Usage in markdown:
 *   <Video src="/media/running-leg.mp4" caption="Leg integration test." />
 *
 * Muted+loop videos autoplay (they read as animated figures); anything
 * with sound gets controls and never autoplays.
 */
interface Props {
  src: string;
  poster?: string;
  caption?: string;
  plate?: string;
  /** Silent looping clip presented as a figure. */
  ambient?: boolean;
  ratio?: string;
}

const { src, poster, caption, plate, ambient = false, ratio = '16/9' } = Astro.props;
---

<figure class="video-fig">
  <div class="plate">
    {plate && <span class="corner">{plate}</span>}
    <div class="well" style={`aspect-ratio: ${ratio};`}>
      <video
        src={src}
        poster={poster}
        controls={!ambient}
        autoplay={ambient}
        loop={ambient}
        muted={ambient}
        playsinline
        preload="metadata"></video>
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .video-fig {
    margin: 0;
  }

  .plate {
    position: relative;
    border: var(--rule-width) solid var(--rule-strong);
    background: var(--paper);
    padding: 8px;
  }

  .corner {
    position: absolute;
    top: 6px;
    left: 12px;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: var(--track-widest);
    color: var(--ink-muted);
  }

  .well {
    position: relative;
    overflow: hidden;
    background: var(--sheet-sunk);
  }

  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  figcaption {
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: 15px;
    color: var(--ink-muted);
  }
</style>
