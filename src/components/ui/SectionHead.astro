---
/**
 * Section heading row, lettered like a drawing's sheet label: an optional
 * sheet number, the section name in tracked capitals, a hairline running
 * out to the right, and an optional aside at its end (a count, a link).
 *
 * The heading is a real heading element so the outline stays correct.
 */
import MonoLabel from './MonoLabel.astro';

interface Props {
  title: string;
  /** Sheet number, e.g. "01". */
  index?: string;
  /** Heading level. Pick to keep the outline sequential, not for size. */
  as?: 'h2' | 'h3';
  /** Plain-text aside. For links or markup, use the `aside` slot. */
  aside?: string;
  class?: string;
}

const { title, index, as: Tag = 'h2', aside, class: className } = Astro.props;
const hasAsideSlot = Astro.slots.has('aside');
---

<div class:list={['section-head', className]}>
  <Tag class="title">
    {index && <span class="index">{index}</span>}
    <span>{title}</span>
  </Tag>
  <span class="leader" aria-hidden="true"></span>
  {
    (aside || hasAsideSlot) && (
      <div class="aside">
        {hasAsideSlot ? <slot name="aside" /> : <MonoLabel size="micro">{aside}</MonoLabel>}
      </div>
    )
  }
</div>

<style>
  .section-head {
    display: flex;
    align-items: center;
    gap: var(--u-half);
    min-height: var(--u);
    margin-bottom: var(--u-2);
  }

  .title {
    display: flex;
    align-items: center;
    gap: var(--u-half);
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    font-weight: var(--w-semibold);
    line-height: var(--lh-grid);
    letter-spacing: var(--track-mono-label);
    text-transform: uppercase;
    color: var(--ink-strong);
  }

  .index {
    color: var(--accent-ink);
  }

  .index::after {
    content: '/';
    margin-left: var(--u-half);
    color: var(--ink-faint);
  }

  /* The hairline that carries the eye from the label to the aside. */
  .leader {
    flex: 1;
    min-width: var(--u);
    height: var(--rule-width);
    background: var(--rule);
  }

  .aside {
    flex: none;
    font-size: var(--t-sm);
  }

  @media (max-width: 560px) {
    .section-head {
      flex-wrap: wrap;
      margin-bottom: var(--u);
    }
  }
</style>
