---
/**
 * A ruled grid of cells — the workhorse for repos, partners, gallery
 * tiles, and spec tables.
 *
 * Each cell draws its own hairline as a 1px box-shadow spreading into a
 * 1px gap, so neighbouring cells share one rule at any column count with
 * no per-cell border bookkeeping. Unlike the earlier approach (painting
 * the container in the rule colour and letting it show through the gap),
 * a short last row leaves clean sheet behind it rather than a grey block.
 */
interface Props {
  /** Fixed column count, or `auto` to fit by min width. */
  cols?: number | 'auto';
  /** Minimum cell width when cols="auto". */
  min?: string;
  class?: string;
}

const { cols = 'auto', min = '200px', class: className } = Astro.props;

const template =
  cols === 'auto' ? `repeat(auto-fill, minmax(${min}, 1fr))` : `repeat(${cols}, 1fr)`;
---

<div class:list={['data-grid', className]} style={`--cols: ${template}; --min: ${min};`}>
  <slot />
</div>

<style>
  .data-grid {
    display: grid;
    grid-template-columns: var(--cols);
    gap: var(--rule-width);
    /* Room for the outer cells' shadow to show. */
    padding: var(--rule-width);
  }

  /* Cells opt in by class so arbitrary children still work. */
  .data-grid > :global(*) {
    background: var(--sheet);
    box-shadow: 0 0 0 var(--rule-width) var(--rule-solid);
    min-width: 0;
  }

  @media (max-width: 860px) {
    .data-grid {
      grid-template-columns: repeat(auto-fill, minmax(min(var(--min), 100%), 1fr));
    }
  }

  @media (max-width: 520px) {
    .data-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
