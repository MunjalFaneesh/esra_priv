---
/**
 * Pixel art, drawn as text and rendered as crisp SVG.
 *
 * A sprite is a list of equal-length strings, one character per pixel.
 * Each character maps to a palette token (see PALETTE below); `.` is
 * transparent. Horizontal runs of the same colour merge into one rect, so
 * a 16x26 sprite is a few dozen elements, not four hundred.
 *
 * Sprites are static by default and show frame one. Pass `animate` to
 * loop two frames (a walk cycle, a gripper closing); motion still stops
 * under prefers-reduced-motion.
 *
 * Sprites are decorative: they are hidden from assistive tech, and the
 * text around them carries the meaning.
 */
interface Props {
  /** One frame, or two for a loop. */
  frames: string[][];
  /** Size of one art pixel, in CSS px. */
  scale?: number;
  /** Loop the two frames. Off by default: the site is calm. */
  animate?: boolean;
  /** Seconds per full two-frame cycle. */
  speed?: number;
  class?: string;
}

const { frames, scale = 6, animate = false, speed = 0.7, class: className } = Astro.props;

/** Palette: art character -> CSS colour token. */
const PALETTE: Record<string, string> = {
  S: 'var(--px-silk)', // silkscreen white — body panels
  D: 'var(--px-dark)', // outline
  M: 'var(--px-metal)', // joints, metal
  G: 'var(--px-pad)', // pad beige — hands, eyes, accents
  C: 'var(--px-trace)', // trace blue
  R: 'var(--px-red)', // status LED
  L: 'var(--px-green)', // second LED
};

const height = frames[0].length;
const width = frames[0][0].length;

for (const [f, frame] of frames.entries()) {
  for (const [y, row] of frame.entries()) {
    if (row.length !== width) {
      throw new Error(
        `PixelSprite: frame ${f}, row ${y} is ${row.length} wide, expected ${width}: "${row}"`
      );
    }
  }
}

/** Merge each row into runs: [{x, y, w, fill}]. */
function runs(frame: string[]) {
  const out: { x: number; y: number; w: number; fill: string }[] = [];
  frame.forEach((row, y) => {
    let x = 0;
    while (x < row.length) {
      const ch = row[x];
      let w = 1;
      while (x + w < row.length && row[x + w] === ch) w++;
      if (ch !== '.' && PALETTE[ch]) out.push({ x, y, w, fill: PALETTE[ch] });
      x += w;
    }
  });
  return out;
}

const rendered = frames.slice(0, animate ? 2 : 1).map(runs);
const animated = rendered.length > 1;
---

<svg
  class:list={['sprite', { animated }, className]}
  viewBox={`0 0 ${width} ${height}`}
  width={width * scale}
  height={height * scale}
  shape-rendering="crispEdges"
  aria-hidden="true"
  style={`--speed: ${speed}s;`}
>
  {
    rendered.map((frame, i) => (
      <g class={`frame f${i}`}>
        {frame.map((r) => (
          <rect x={r.x} y={r.y} width={r.w} height="1" style={`fill: ${r.fill}`} />
        ))}
      </g>
    ))
  }
</svg>

<style>
  .sprite {
    display: block;
    image-rendering: pixelated;
    max-width: 100%;
    height: auto;
  }

  .animated .f0 {
    animation: frame-a var(--speed) steps(1, end) infinite;
  }

  .animated .f1 {
    animation: frame-b var(--speed) steps(1, end) infinite;
  }

  @keyframes frame-a {
    0% {
      visibility: visible;
    }
    50% {
      visibility: hidden;
    }
  }

  @keyframes frame-b {
    0% {
      visibility: hidden;
    }
    50% {
      visibility: visible;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .animated .f0 {
      animation: none;
      visibility: visible;
    }
    .animated .f1 {
      animation: none;
      visibility: hidden;
    }
  }
</style>
