---
/**
 * The drawing sheet. Every page sits on it.
 *
 * It sets the content measure that each full-bleed band centres on
 * (--content-max) and nothing else: the drafting grid behind the page is
 * painted once on <body> (see global.css), so the sheet itself carries no
 * decoration.
 */
interface Props {
  /** Kept for API compatibility; the drafting grid is always on. */
  grid?: boolean;
  /** Widen the content measure (used by the gallery). */
  wide?: boolean;
  class?: string;
}

const { wide = false, class: className } = Astro.props;
---

<div class:list={['sheet', { wide }, className]}>
  <slot />
</div>

<style>
  .sheet {
    --content-max: var(--sheet-max);

    position: relative;
    min-height: 100vh;
    color: var(--ink-strong);
    overflow-x: clip;
  }

  .sheet.wide {
    --content-max: 1400px;
  }
</style>
