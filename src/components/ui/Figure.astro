---
/**
 * A plated figure: a framed well, an optional annotation row beneath it,
 * and the duotone and dot-screen treatment that prints a photo in the
 * sheet's own blue-black.
 *
 * The well is sized in whole grid cells: as wide as its column, and as
 * tall as the ratio asks for, rounded up to the next cell. Its frame is
 * painted on the grid lines around it rather than laid out as a border.
 *
 * Images go through astro:assets, so the multi-megabyte source photos
 * migrated from the old site ship as sized, modern-format derivatives.
 * Remote or `public/` sources fall back to a plain <img>.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata | string;
  alt?: string;
  /** Annotations under the plate, in the FIG.1 / part-number idiom. */
  plate?: string;
  ref?: string;
  /** Caption below the plate. Also accepts the `caption` slot. */
  caption?: string;
  ratio?: string;
  /** Halftone dot overlay. Off for diagrams and logos. */
  dither?: boolean;
  /** Desaturate to match the printed look. */
  mono?: boolean;
  fit?: 'cover' | 'contain';
  /** Rendered width hint for the optimiser. */
  width?: number;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  src,
  alt = '',
  plate,
  ref,
  caption,
  ratio = '4/5',
  dither = true,
  mono = true,
  fit = 'cover',
  width = 900,
  loading = 'lazy',
  class: className,
} = Astro.props;

const isLocal = typeof src === 'object' && src !== null;

// "4/5" -> height as a multiple of width, for the cell-rounded well.
const [rw, rh] = ratio.split('/').map(Number);
const tall = rw > 0 && rh > 0 ? rh / rw : 1;
const hasCaption = caption || Astro.slots.has('caption');
---

<figure class:list={['figure', className]} data-draw>
  <div class="plate">
    <div class="well frame" style={`--tall: ${tall};`}>
      {
        isLocal ? (
          <Image
            src={src as ImageMetadata}
            alt={alt}
            width={width}
            loading={loading}
            class:list={['media', { mono }]}
            style={`object-fit: ${fit};`}
          />
        ) : src ? (
          <img
            src={src as string}
            alt={alt}
            loading={loading}
            decoding="async"
            class:list={['media', { mono }]}
            style={`object-fit: ${fit};`}
          />
        ) : (
          <slot />
        )
      }

      {dither && <div class="dither" aria-hidden="true" />}
    </div>
  </div>

  {
    (plate || ref) && (
      <div class="marks" aria-hidden="true">
        <span class="mark-plate">{plate}</span>
        <span class="mark-ref">{ref}</span>
      </div>
    )
  }

  {
    hasCaption && (
      <figcaption class="caption">
        {caption ? <span set:html={caption} /> : <slot name="caption" />}
      </figcaption>
    )
  }
</figure>

<style>
  .figure {
    margin: 0;
  }

  /* The plate is the measuring stick: 100cqi is the column's width. */
  .plate {
    container-type: inline-size;
  }

  .well {
    --frame-color: var(--rule-strong);
    --well-h: round(up, calc(100cqi * var(--tall)), var(--u));
    height: var(--well-h);
    background: var(--sheet);
    isolation: isolate;
  }

  /*
   * Printing. On arrival the plate prints top to bottom one row of grid
   * cells at a time, like a raster coming off a plotter: --printed runs
   * down the well at an even speed and the clip rounds it down to whole
   * cells, so the image steps rather than wipes. The frame is there from
   * the start; only the picture prints.
   */
  @property --printed {
    syntax: '<length>';
    inherits: true;
    initial-value: 0px;
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    .well {
      --printed: var(--well-h);
    }

    .well > :global(*) {
      clip-path: inset(0 0 calc(var(--well-h) - round(down, var(--printed), var(--u))) 0);
    }

    :global(.js) .figure:not(.revealed) .well {
      --printed: 0px;
    }

    .figure.revealed .well {
      animation: print-rows 1.1s linear backwards;
    }
  }

  @keyframes print-rows {
    from {
      --printed: 0px;
    }
  }

  .media {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* The annotation row: plate number left, part reference right. */
  .marks {
    display: flex;
    justify-content: space-between;
    gap: var(--u);
    font-size: var(--t-micro);
    font-weight: var(--w-medium);
    line-height: var(--lh-grid);
    letter-spacing: var(--track-mono-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .mark-plate {
    font-family: var(--font-pixel);
    font-size: var(--t-pixel);
    font-weight: var(--w-regular);
    letter-spacing: 0;
    color: var(--accent-ink);
  }

  /* Duotone: a greyscale photo screened over the sheet, so shadows take
     its blue-black and highlights print as warm white. */
  .media.mono {
    filter: grayscale(1) contrast(1.2) brightness(0.95);
    mix-blend-mode: screen;
  }

  /* Halftone dot screen */
  .dither {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(var(--dither-dot) 0.5px, transparent 0.7px);
    background-size: var(--dither-size) var(--dither-size);
    mix-blend-mode: multiply;
    opacity: 0.42;
  }

  .caption {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: var(--lh-grid);
    color: var(--ink-muted);
  }

  .caption :global(strong) {
    color: var(--ink-strong);
    font-weight: var(--w-semibold);
  }

  /* The treatment is decorative; drop it when the OS asks for plain output. */
  @media (forced-colors: active) {
    .dither {
      display: none;
    }
    .media.mono {
      filter: none;
    }
  }
</style>
