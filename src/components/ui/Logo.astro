  ></path>
  <path
    transform="translate(239.84,311.6) scale(0.16,-0.16)"
    d="M80 675V557H450C515 557 544 516 544 468C544 420 517 374 450 374H187C113 374 81 343 81 267V0H199V244C199 256 205 261 216 261H392L546 0H677L520 270C623 299 663 389 663 473C663 581 598 675 446 675Z"
