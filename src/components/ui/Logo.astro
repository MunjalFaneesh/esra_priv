---
/**
 * ESRA wordmark.
 *
 * Path data is the generated output of esrabot/logo (release v17,
 * `esra-transparent.svg`), which renders the mark from Nasalization Rg.
 * These are outlines, so no font is needed or shipped at runtime.
 *
 * The viewBox crops the 512x512 canvas to the wordmark's ink extents.
 * Fill is currentColor so the mark inherits its surroundings.
 */
interface Props {
  /** Rendered height in px. Width follows the aspect ratio. */
  height?: number;
  /** Accessible label. Set to null when the mark is decorative. */
  label?: string | null;
  class?: string;
}

const { height = 24, label = 'ESRA', class: className } = Astro.props;

// A labelled mark is an image; an unlabelled one is decorative and hidden
// from assistive tech, so its accessible name comes from the link around it.
const a11y = label
  ? ({ role: 'img', 'aria-label': label } as const)
  : ({ 'aria-hidden': 'true' } as const);
---

<svg
  viewBox="44 196 424 122"
  height={height}
  class:list={['logo', className]}
  fill="currentColor"
  {...a11y}
>
