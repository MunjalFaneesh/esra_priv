---
/**
 * The teletype band at the top and bottom of every sheet — file path on
 * the left, build provenance on the right.
 *
 * The git ref and SHA are real: they come from the deploying commit via
 * Vercel's environment. Locally there is no commit to report, so the band
 * says "local" rather than inventing a hash.
 */
import MonoLabel from './MonoLabel.astro';
import { buildInfo, SITE } from '../../data/site';

interface Props {
  /** Repository-relative path of the source file for this page. */
  path: string;
  /** Render as the closing band (border-top instead of border-bottom). */
  foot?: boolean;
  /** Link text on the right of the opening band. */
  sourceHref?: string;
}

const { path, foot = false, sourceHref = SITE.orgUrl } = Astro.props;
const build = buildInfo();
---

<div class:list={['colophon', { foot }]}>
  <MonoLabel size="micro" track="widest">
    {
      foot ? (
        <>
          &copy; {new Date().getFullYear()} {SITE.name} &middot; esra.bot &middot; {SITE.license}
        </>
      ) : (
        <>
          {SITE.name} &middot; {path}
        </>
      )
    }
  </MonoLabel>

  <MonoLabel size="micro" track="widest" class="right">
    {
      build.sha ? (
        <>
          <span>
            &#8903; {build.ref}@{build.sha}
          </span>
          <a href={build.commitUrl} rel="noopener">
            commit &#8599;
          </a>
        </>
      ) : (
        <span>&#8903; local build &middot; {build.date}</span>
      )
    }
    {
      !foot && (
        <a href={sourceHref} rel="noopener">
          source &#8599;
        </a>
      )
    }
  </MonoLabel>
</div>

<style>
  .colophon {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--u-half);
    min-height: var(--u-2);
    padding-block: var(--u-quarter);
    /* Centre on the content measure while the band itself runs full-bleed. */
    padding-inline: var(--edge) var(--edge-end);
    /* The rule sits on the grid line below the band, over the header. */
    position: relative;
    z-index: calc(var(--z-sticky) + 1);
    box-shadow: 0 var(--rule-width) 0 var(--rule);
  }

  .colophon.foot {
    z-index: auto;
    box-shadow: inset 0 var(--rule-width) 0 var(--rule);
  }

  .colophon :global(.right) {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    text-align: right;
  }

  .colophon a {
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .colophon {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      padding-block: var(--u-half);
    }

    .colophon :global(.right) {
      text-align: left;
    }
  }
</style>
