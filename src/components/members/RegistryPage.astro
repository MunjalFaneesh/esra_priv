---
/**
 * The members registry page body, shared by /members and /<slug>.
 *
 * Both routes render the same roster; they differ only in which record is
 * selected and what the page reports as its title. Keeping the chrome here
 * means the two routes stay in step.
 */
import { getCollection, type CollectionEntry } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import MonoLabel from '../../components/ui/MonoLabel.astro';
import DataGrid from '../../components/ui/DataGrid.astro';
import PartnerMark from '../../components/ui/PartnerMark.astro';
import MemberRoster from './MemberRoster.astro';

interface Props {
  members: CollectionEntry<'members'>[];
  selected: CollectionEntry<'members'>;
  /** True on /members, false on an individual member's page. */
  isIndex: boolean;
}

const { members, selected, isIndex } = Astro.props;

const partners = await getCollection('partners');

const title = isIndex ? 'Members' : selected.data.name;
const description = isIndex
  ? 'The people building ESRA in the open, across affiliated clubs and schools.'
  : `${selected.data.name}${
      selected.data.affiliation ? ` — ${selected.data.affiliation}` : ''
    }. Part of ESRA.`;
---

<BaseLayout title={title} description={description} sourcePath="site/members.astro">
  <Section pad="hero">
    <div class="masthead">
      <div>
        <MonoLabel as="div" size="sm" track="label">Core collaborators · registry</MonoLabel>
        <h1 class="on-grid">Members</h1>
        <p class="lede on-grid">
          The people building ESRA in the open, across affiliated clubs and schools. Select a name
          to read their record and find them elsewhere.
        </p>
      </div>
      <MonoLabel as="div" size="micro" track="wide" class="counts">
        N={members.length} · core<br />consortium registry<br />rev {
          new Date().toISOString().slice(0, 7).replace('-', '.')
        }
      </MonoLabel>
    </div>
  </Section>

  <MemberRoster members={members} selected={selected} />

  <Section id="clubs" pad="normal" last>
    <SectionHead title="Affiliated partners" aside={`N=${partners.length}`} />
    <DataGrid min="220px">
      {
        partners.map((p) => (
          <a class="club" href={p.data.url} rel="noopener" target="_blank">
            <div class="club-top">
              <div class="club-mark">
                <PartnerMark partner={p} height={48} maxWidth={120} decorative />
              </div>
              <span class="arrow" aria-hidden="true">
                &#8599;
              </span>
            </div>
            <div class="club-name">{p.data.name}</div>
            <MonoLabel as="div" size="micro" track="wide" upper={false} class="club-meta">
              {[p.data.school, p.data.location].filter(Boolean).join(' · ')}
            </MonoLabel>
          </a>
        ))
      }
    </DataGrid>
  </Section>
</BaseLayout>

<style>
  .masthead {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--u);
  }

  h1 {
    margin: var(--u) 0 0;
    font-family: var(--font-display);
    font-size: var(--t-display);
    font-weight: var(--w-bold);
    --lh: var(--lh-h1);
    line-height: var(--lh);
    letter-spacing: var(--track-snug);
    text-transform: uppercase;
  }

  .lede {
    margin: var(--u) 0 0;
    max-width: 456px;
    font-size: var(--t-md);
    line-height: var(--lh-grid);
    color: var(--ink-body);
  }

  .masthead :global(.counts) {
    text-align: right;
    white-space: nowrap;
    flex: none;
  }

  .club {
    display: block;
    padding: var(--u);
    text-decoration: none;
    color: var(--ink-strong);
  }

  /* DataGrid cells are solid --sheet, so the wash is composited onto it. */
  .club:hover {
    background: linear-gradient(var(--accent-wash), var(--accent-wash)), var(--sheet);
    color: var(--ink-strong);
  }

  .club-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--u-half);
  }

  /* The mark takes its colour from here: warm white, beige on hover. */
  .club-mark {
    display: flex;
    align-items: center;
    height: var(--u-2);
    color: var(--ink);
    transition: color var(--dur) var(--ease);
  }

  .club:hover .club-mark {
    color: var(--accent);
  }

  .arrow {
    color: var(--ink-faint);
    font-size: var(--t-mono);
    line-height: var(--lh-grid);
    transition: color var(--dur) var(--ease);
  }

  .club:hover .arrow {
    color: var(--accent-ink);
  }

  .club-name {
    margin-top: var(--u);
    font-size: var(--t-md);
    font-weight: var(--w-semibold);
    line-height: var(--lh-grid);
  }

  .club :global(.club-meta) {
    margin-top: 2px;
  }

  @media (max-width: 640px) {
    .masthead {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--u-half);
    }

    .masthead :global(.counts) {
      text-align: left;
    }
  }
</style>
