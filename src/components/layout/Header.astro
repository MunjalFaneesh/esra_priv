---
/**
 * Sheet header — wordmark, expanded org name, primary nav.
 *
 * The nav is a plain list of links with no JS. Below the breakpoint it
 * becomes a horizontally scrollable rail rather than a hamburger menu:
 * six items don't justify hiding navigation behind a toggle.
 */
import Logo from '../ui/Logo.astro';
import { NAV, SITE } from '../../data/site';

interface Props {
  /** Path of the current page, used to mark the active nav item. */
  current?: string;
}

const { current = '' } = Astro.props;

const isActive = (href: string) =>
  href !== '/' && (current === href || current.startsWith(href + '/'));
---

<header class="header">
  <a href="/" class="brand" aria-label={`${SITE.name} home`}>
    <Logo height={24} label={null} />
    <span class="expanded" aria-hidden="true">
      Experimental Student<br />Robotics Association
    </span>
  </a>

  <nav class="nav" aria-label="Primary">
    <ul>
      {
        NAV.map(({ label, href, mono }) => (
          <li>
            <a
              href={href}
              class:list={['nav-link', { mono, active: isActive(href) }]}
              aria-current={isActive(href) ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--u);
    min-height: var(--u-3);
    padding: var(--u-half) var(--u);
    border-bottom: var(--rule-width) solid var(--rule);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--u-half);
    text-decoration: none;
    color: var(--ink-strong);
    flex: none;
  }

  .expanded {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: 12px; /* sub-grid: two 12px lines sum to one 24px cell */
    letter-spacing: var(--track-widest);
    text-transform: uppercase;
    color: var(--ink-muted);
    border-left: var(--rule-width) solid var(--rule);
    padding-left: var(--u-half);
  }

  .nav ul {
    display: flex;
    align-items: center;
    gap: var(--u);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    font-size: var(--t-sm);
    color: var(--ink-body);
    white-space: nowrap;
  }

  .nav-link.active {
    color: var(--ink-strong);
    font-weight: var(--w-semibold);
    text-decoration: none;
  }

  .nav-link.mono {
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    color: var(--ink-muted);
    text-decoration: none;
    letter-spacing: var(--track-wide);
  }

  @media (max-width: 900px) {
    .expanded {
      display: none;
    }
    .nav ul {
      gap: var(--u-half);
    }
  }

  @media (max-width: 720px) {
    .header {
      flex-direction: column;
      align-items: stretch;
      gap: var(--u-half);
      padding: var(--u-half);
    }

    /* Scrollable rail — keeps every destination one tap away. */
    .nav {
      overflow-x: auto;
      scrollbar-width: none;
      margin: 0 calc(-1 * var(--u-half));
      padding: 0 var(--u-half);
    }

    .nav::-webkit-scrollbar {
      display: none;
    }

    .nav ul {
      gap: var(--u);
      padding-bottom: 2px;
    }
  }
</style>
