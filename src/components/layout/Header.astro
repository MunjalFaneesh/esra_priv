---
/**
 * Site header.
 *
 * Wordmark, the primary nav lettered in small capitals, and one call to
 * action. Sticky on a translucent sheet with a backdrop blur. No JS:
 * below the breakpoint the nav becomes a horizontally scrollable rail
 * rather than a hamburger.
 */
import Logo from '../ui/Logo.astro';
import { NAV, SITE } from '../../data/site';

interface Props {
  /** Path of the current page, used to mark the active nav item. */
  current?: string;
}

const { current = '' } = Astro.props;

const isActive = (href: string) =>
  href !== '/' && (current === href || current.startsWith(href + '/'));
---

<header class="header">
  <a href="/" class="brand" aria-label={`${SITE.name} home`}>
    <Logo height={22} label={null} />
  </a>

  <nav class="nav" aria-label="Primary">
    <ul>
      {
        NAV.map(({ label, href }) => (
          <li>
            <a
              href={href}
              class:list={['nav-link', { active: isActive(href) }]}
              aria-current={isActive(href) ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <a href="/#join" class="btn sm cta">Get involved</a>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    display: flex;
    align-items: center;
    gap: var(--u);
    min-height: var(--u-3);
    padding-block: var(--u-half);
    padding-inline: max(var(--gutter), calc((100% - var(--content-max, var(--sheet-max))) / 2));
    border-bottom: var(--rule-width) solid var(--rule);
    background: var(--sheet-glass);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  @supports not (backdrop-filter: blur(1px)) {
    .header {
      background: var(--sheet);
    }
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--u-half);
    text-decoration: none;
    color: var(--ink-strong);
    flex: none;
  }

  .nav {
    margin-left: auto;
  }

  .nav ul {
    display: flex;
    align-items: center;
    gap: var(--u);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    position: relative;
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    font-weight: var(--w-medium);
    letter-spacing: var(--track-widest);
    text-transform: uppercase;
    color: var(--ink-muted);
    white-space: nowrap;
    text-decoration: none;
  }

  .nav-link:hover {
    color: var(--ink-strong);
  }

  /* Active page: a beige rule under the label. */
  .nav-link.active {
    color: var(--accent-ink);
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: var(--rule-width);
    background: var(--accent);
  }

  .cta {
    flex: none;
  }

  @media (max-width: 1060px) {
    .nav ul {
      gap: var(--u-half);
    }
  }

  @media (max-width: 860px) {
    .header {
      flex-wrap: wrap;
      gap: var(--u-half);
    }

    .cta {
      margin-left: auto;
    }

    .nav {
      order: 3;
      flex-basis: 100%;
      margin-left: calc(-1 * var(--gutter));
      margin-right: calc(-1 * var(--gutter));
      padding: 0 var(--gutter);
      overflow-x: auto;
      scrollbar-width: none;
    }

    .nav::-webkit-scrollbar {
      display: none;
    }

    .nav ul {
      gap: var(--u);
      padding-bottom: var(--u-half);
    }

    .nav-link.active::after {
      bottom: -6px;
    }
  }
</style>
