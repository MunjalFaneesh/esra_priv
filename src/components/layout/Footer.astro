---
/**
 * Site footer.
 *
 * A closing line with the one call to action, a block of numbered notes
 * (true statements about the organisation, in the voice of a drawing's
 * notes column), then the link columns. Channel columns come
 * from the org registry, so an account appears here or does not exist.
 */
import Logo from '../ui/Logo.astro';
import MonoLabel from '../ui/MonoLabel.astro';
import { CONTACTS, NAV, SITE } from '../../data/site';
import { ORGS, PLATFORM_META } from '../../data/orgs';

const siteLinks = NAV.filter((n) => !n.mono);
const general = CONTACTS[0];

const notes = [
  `Designs released under ${SITE.license}.`,
  'Built by students, across campuses, in the open.',
  `${SITE.incorporated}.`,
  `Questions, partnerships, press: ${general.address}`,
];
---

<footer class="footer">
  <div class="closer">
    <p class="statement">Robots no single campus could build alone.</p>
    <a class="btn" href="/#join">Get involved <span class="arrow">&#8594;</span></a>
  </div>

  <div class="cols">
    <div class="about">
      <Logo height={22} label={null} />
      <MonoLabel as="div" size="micro" track="widest" class="notes-head">Notes</MonoLabel>
      <ol class="notes">
        {notes.map((n) => <li>{n}</li>)}
      </ol>
    </div>

    <nav class="col" aria-label="Site">
      <div class="col-head">Site</div>
      <ul>
        {
          siteLinks.map(({ label, href }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="col" aria-label="Source">
      <div class="col-head">Source</div>
      <ul>
        <li><a href={SITE.orgUrl} rel="noopener">GitHub &#8599;</a></li>
        <li><a href={SITE.repoUrl} rel="noopener">This site &#8599;</a></li>
        <li><a href="/rss.xml">RSS feed</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/colophon">Colophon</a></li>
      </ul>
    </nav>

    {
      ORGS.map((org) => (
        <nav class="col" aria-label={`${org.name} channels`}>
          <div class="col-head">{org.name}</div>
          <ul>
            {org.links
              .filter((l) => l.platform !== 'website' || org.id !== 'esra')
              .map((link) => (
                <li>
                  <a href={link.url} rel="noopener">
                    {PLATFORM_META[link.platform].label} &#8599;
                  </a>
                </li>
              ))}
          </ul>
        </nav>
      ))
    }
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--u-4) var(--u-3);
    padding-inline: max(var(--gutter), calc((100% - var(--content-max, var(--sheet-max))) / 2));
    border-top: var(--rule-width) solid var(--rule-strong);
    background: var(--veil); /* darken the drafting grid, never repaint it */
  }

  .closer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--u-2);
    flex-wrap: wrap;
    padding-bottom: var(--u-3);
    margin-bottom: var(--u-3);
    border-bottom: var(--rule-width) solid var(--rule);
  }

  .statement {
    margin: 0;
    max-width: 720px;
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: var(--w-semibold);
    line-height: var(--lh-h1);
    letter-spacing: var(--track-tight);
    color: var(--ink-strong);
  }

  .cols {
    display: grid;
    grid-template-columns: 1.8fr repeat(4, 1fr);
    gap: var(--u-2);
  }

  .about :global(.notes-head) {
    display: block;
    margin-top: var(--u);
  }

  .notes {
    margin: var(--u-quarter) 0 0;
    padding-left: var(--u);
    font-size: var(--t-sm);
    line-height: var(--lh-grid);
    color: var(--ink-muted);
  }

  .notes li::marker {
    color: var(--accent-ink);
  }

  .col-head {
    margin-bottom: var(--u-half);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    font-weight: var(--w-semibold);
    line-height: var(--lh-grid);
    letter-spacing: var(--track-mono-label);
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  .col ul {
    display: flex;
    flex-direction: column;
    gap: var(--u-quarter);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--t-sm);
  }

  .col a {
    text-decoration: none;
    color: var(--ink-body);
  }

  .col a:hover {
    color: var(--accent-ink);
  }

  @media (max-width: 980px) {
    .cols {
      grid-template-columns: 1fr 1fr 1fr;
      gap: var(--u);
    }
    .about {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .footer {
      padding-block: var(--u-3) var(--u-2);
    }
    .cols {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
