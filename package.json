{
  "name": "@esrabot/web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "ESRA — Experimental Student Robotics Association. Built in the open.",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "typecheck": "astro check --minimumSeverity error",
    "format": "prettier --write \"**/*.{astro,ts,js,mjs,json,md,mdx,css,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{astro,ts,js,mjs,json,md,mdx,css,yaml,yml}\"",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:links": "node scripts/validate-links.mjs",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.3",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@iconify-json/lucide": "^1.2.118",
    "@iconify-json/simple-icons": "^1.2.90",
    "astro": "^7.1.1",
    "astro-icon": "^1.1.5",
    "mdast-util-to-string": "^4.0.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0"
  }
}
